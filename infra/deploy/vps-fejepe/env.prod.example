# Exemplo SINTÉTICO do /opt/portal-federacoes/.env.prod. Não preencha este arquivo:
# gere o real no servidor com
#   python3 scripts/configurar_docker.py --producao \
#     --dominio federacoes.portalfejepe.cloud --destino /opt/portal-federacoes/.env.prod
# O gerador cria com permissão 600 e senhas aleatórias, e nunca sobrescreve.
POSTGRES_DB=portal
POSTGRES_USER=portal_owner
POSTGRES_PASSWORD=troque-gerado-pelo-script-0000000000000000000000000000000000000000
APP_DB_PASSWORD=troque-gerado-pelo-script-1111111111111111111111111111111111111111
AUTH_DB_PASSWORD=troque-gerado-pelo-script-2222222222222222222222222222222222222222
INGESTAO_DB_PASSWORD=troque-gerado-pelo-script-3333333333333333333333333333333333333333
FRONTEND_PORT=8080
TENANT_SLUG=fejepe
PORTAL_DOMAIN=federacoes.portalfejepe.cloud
CONVITE_REDIRECT_URL=https://federacoes.portalfejepe.cloud/definir-senha
CORS_ORIGINS=https://federacoes.portalfejepe.cloud
DOCS_ENABLED=false
# Nexo e resumo do mês por IA desligados até a decisão do provedor. Sem IA, a
# Análise do mês mostra o resumo em frases fixas.
IA_PROVEDOR=openrouter
IA_MODELO=
IA_API_KEY=
IA_BASE_URL=
