# Para Docker, prefira python3 scripts/configurar_docker.py: gera .env.docker
# com senhas aleatórias e permissão 600, sem sobrescrever configuração existente.
# Subida: docker compose --env-file .env.docker up --build -d
POSTGRES_USER=portal_owner
POSTGRES_DB=portal
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
INGESTAO_DB_PASSWORD=
FRONTEND_PORT=8080
TENANT_SLUG=fejepe
CONVITE_REDIRECT_URL=http://localhost:8080/definir-senha
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DOCS_ENABLED=false
FEEDBACK_FORM_URL=

# Opcionais, exclusivos do backend. Sem configuração, Nexo informa indisponibilidade.
IA_PROVEDOR=openrouter
IA_BASE_URL=
IA_MODELO=
IA_API_KEY=
