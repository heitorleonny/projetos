# Copie para `.env` na raiz. O compose lê este arquivo automaticamente.

# ── Supabase (obrigatório para backend e frontend) ───────────
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave ANÔNIMA: é a do caminho de request. RESPEITA Row Level Security — o
# cliente é criado com ela e recebe o JWT do usuário, então as políticas
# filtram por federação. É a única chave que o backend da API precisa.
SUPABASE_ANON_KEY=sua-anon-key
# Chave de SERVIÇO: IGNORA Row Level Security (role `service_role`). Só para
# script administrativo fora do ciclo de requisição (carga, migração,
# backfill). Se ela vazar para o caminho de request, o isolamento entre
# federações deixa de existir. Deixe em branco se você não roda esses scripts.
SUPABASE_SERVICE_KEY=
# Nome antigo, de quando havia uma chave só. Ainda aceito como fallback de
# SUPABASE_ANON_KEY; migre e apague.
# SUPABASE_KEY=sua-anon-key
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# ── Portas publicadas no host ────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ── Frontend: build time (default embutido na imagem) ────────
# Estas entram no bundle quando a imagem é construída. Depois da entrada do
# env-config.js elas são só o DEFAULT: o que o container receber em runtime
# (bloco abaixo) tem precedência. Ver front_portal_fejepe/src/config/env.ts.
VITE_API_BASE_URL=/api/v1
# No perfil dev o Vite fala direto com o backend.
VITE_API_BASE_URL_DEV=http://localhost:8000/api/v1
VITE_USE_MOCK=false
VITE_FEEDBACK_FORM_URL=

# ── Frontend: runtime (override por deploy, sem rebuild) ─────
# Lidas no START do container por front_portal_fejepe/docker-entrypoint.sh e
# publicadas em window.__ENV__. Sem o prefixo VITE_, que só faz sentido no
# build. Vazio = usa o default do bundle.
#
# ATENÇÃO: tudo daqui é servido ao navegador. Só valores públicos.
API_BASE_URL=/api/v1
USE_MOCK=false
FEEDBACK_FORM_URL=
# Qual federação esta instância serve, por `federacao.slug`.
#
# PROVISÓRIO: a resolução do tenant é por variável de ambiente, NÃO por
# domínio. Funciona para uma federação declarada no deploy; não para N
# federações simultâneas no mesmo servidor. A versão real disto (subdomínio,
# DNS wildcard, certificado, roteamento) é decisão de arquitetura à parte.
TENANT_SLUG=fejepe

# ── Backend ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
ANO_DEFAULT=2026
# Documentação interativa (/docs, /redoc, /openapi.json): feche em produção.
DOCS_ENABLED=false

# ── Laboratório de dados do TCC (perfil `lab`) ───────────────
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal_lab
# 55432 evita o choque com um Postgres instalado na máquina (Homebrew,
# Postgres.app), que ocupa a 5432 e sequestra as conexões a localhost.
POSTGRES_PORT=55432
