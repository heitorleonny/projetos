              "title": "Ano"
            },
            "description": "Ano de referência"
          },
          {
            "name": "mes",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 12,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Mês de referência (1-12). Omita para usar acumulado até o último mês disponível.",
              "title": "Mes"
            },
            "description": "Mês de referência (1-12). Omita para usar acumulado até o último mês disponível."
          },
          {
            "name": "cluster",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 5,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por cluster (1-5)",
              "title": "Cluster"
            },
            "description": "Filtrar por cluster (1-5)"
          },
          {
            "name": "comunidade",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por comunidade",
              "title": "Comunidade"
            },
            "description": "Filtrar por comunidade"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por status da EJ",
              "title": "Status"
            },
            "description": "Filtrar por status da EJ"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Busca por nome da EJ",
              "title": "Search"
            },
            "description": "Busca por nome da EJ"
          },
          {
            "name": "ordem_por",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrdemEmpresa",
              "description": "Campo de ordenação",
              "default": "nome"
            },
            "description": "Campo de ordenação"
          },
          {
            "name": "direcao",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Direcao",
              "description": "Direção da ordenação",
              "default": "asc"
            },
            "description": "Direção da ordenação"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Página atual",
              "default": 1,
              "title": "Page"
            },
            "description": "Página atual"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Itens por página",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Itens por página"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
