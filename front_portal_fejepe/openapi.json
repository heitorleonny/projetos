            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 10,
              "description": "IDs das EJs a comparar (id_ej). Min 2, max 10.",
              "title": "Ids"
            },
            "description": "IDs das EJs a comparar (id_ej). Min 2, max 10."
          },
          {
            "name": "ano",
            "in": "query",
            "required": false,
