    "/api/v1/rede/ranking": {
      "get": {
        "tags": [
          "Rede"
        ],
        "summary": "Ranking de EJs",
        "description": "Gera ranking dinâmico de EJs por critério: faturamento, CSAT, projetos ou faturamento colaborativo. Pode ser filtrado por cluster e comunidade.",
        "operationId": "get_ranking_api_v1_rede_ranking_get",
        "parameters": [
          {
            "name": "ano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Ano de referência",
              "default": 2026,
              "title": "Ano"
            },
            "description": "Ano de referência"
          },
          {
            "name": "mes",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 12,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Mês de referência",
              "title": "Mes"
            },
            "description": "Mês de referência"
          },
          {
            "name": "criterio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(faturamento|csat|projetos|colab)$",
              "description": "Critério de ranking: faturamento, csat, projetos, colab",
              "default": "faturamento",
              "title": "Criterio"
            },
            "description": "Critério de ranking: faturamento, csat, projetos, colab"
          },
          {
            "name": "cluster",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 5,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por cluster",
              "title": "Cluster"
            },
            "description": "Filtrar por cluster"
          },
          {
            "name": "comunidade",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por comunidade",
              "title": "Comunidade"
            },
            "description": "Filtrar por comunidade"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Máximo de itens no ranking",
              "default": 20,
              "title": "Limit"
            },
            "description": "Máximo de itens no ranking"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RankingItem"
                  },
                  "title": "Response Get Ranking Api V1 Rede Ranking Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
