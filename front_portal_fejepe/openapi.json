{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal FEJEPE API",
    "description": "API do Portal FEJEPE — centraliza dados e cálculos estratégicos das Empresas Juniores da rede. Permite consultar EJs, comparar indicadores, visualizar KPIs da rede e gerar rankings.",
    "version": "0.1.0"
  },
