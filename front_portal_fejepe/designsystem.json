{
  "name": "fejepe-design-system",
  "version": "1.0.0",
  "brand": {
    "primaryColor": "blue",
    "description": "Identidade visual baseada em azul institucional com apoio de branco e tons neutros."
  },
  "colors": {
    "primary": {
      "50": "#E6F0FA",
      "100": "#CCE1F5",
      "200": "#99C3EB",
      "300": "#66A5E0",
      "400": "#3387D6",
      "500": "#0D6EFD",
      "600": "#0A58CA",
      "700": "#084298",
      "800": "#052C65",
      "900": "#031633"
    },
    "secondary": {
      "500": "#1E293B",
      "600": "#0F172A"
    },
    "neutral": {
      "white": "#FFFFFF",
      "50": "#F8FAFC",
      "100": "#F1F5F9",
      "200": "#E2E8F0",
      "300": "#CBD5E1",
      "400": "#94A3B8",
      "500": "#64748B",
      "600": "#475569",
      "700": "#334155",
      "800": "#1E293B",
      "900": "#0F172A",
      "black": "#000000"
    },
    "feedback": {
      "success": "#16A34A",
      "warning": "#F59E0B",
      "error": "#DC2626",
      "info": "#0D6EFD"
    },
    "background": {
      "default": "#F8FAFC",
      "surface": "#FFFFFF",
      "dark": "#0F172A"
    }
  },
  "typography": {
    "fontFamilies": {
      "primary": "'Montserrat', 'Poppins', 'Segoe UI', sans-serif",
      "secondary": "'Inter', 'Roboto', sans-serif",
      "monospace": "'Fira Code', monospace"
    },
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "sizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "lineHeights": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "borderRadius": {
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 6px rgba(0,0,0,0.08)",
    "lg": "0 10px 15px rgba(0,0,0,0.1)",
    "xl": "0 20px 25px rgba(0,0,0,0.15)"
  },
  "layout": {
    "maxWidth": "1200px",
    "spacingUnit": "8px"
  },
  "components": {
    "button": {
      "primary": {
        "background": "{colors.primary.600}",
        "color": "{colors.neutral.white}",
        "hoverBackground": "{colors.primary.700}",
        "borderRadius": "{borderRadius.md}"
      },
      "secondary": {
        "background": "{colors.neutral.white}",
        "color": "{colors.primary.600}",
        "border": "1px solid {colors.primary.600}",
        "hoverBackground": "{colors.primary.50}"
      }
    },
    "card": {
      "background": "{colors.background.surface}",
      "borderRadius": "{borderRadius.lg}",
      "shadow": "{shadows.md}",
      "padding": "24px"
    },
    "navbar": {
      "background": "{colors.primary.700}",
      "color": "{colors.neutral.white}",
      "height": "64px"
    }
  }
}
