# Desenvolvimento local (`npm run dev`). O Vite congela estas variáveis no
# bundle; em container elas viram apenas o default, e o que vale é o que o
# docker-entrypoint.sh escreve em window.__ENV__. Ver src/config/env.ts.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FEEDBACK_FORM_URL=
# Marca exibida antes do login. Após autenticar, marca e dados seguem
# a federação vinculada à conta. Vazio = fejepe.
VITE_TENANT_SLUG=fejepe
